# ==========================================
# Take Machine - Coolify Environment Configuration Template
# ==========================================
# Copy this file to .env.coolify.local and populate with your real secrets.
# Do NOT commit .env.coolify.local to your repository.

# Database & Secrets (Set these locally in .env.coolify.local)
DATABASE_URL=SET_IN_COOLIFY_ONLY
ADMIN_PASSWORD=SET_IN_COOLIFY_ONLY
RSS_PREVIEW_TOKEN=SET_IN_COOLIFY_ONLY

# AI & Third-Party APIs (Set these locally in .env.coolify.local)
ANTHROPIC_API_KEY=SET_IN_COOLIFY_ONLY
EXA_API_KEY=SET_IN_COOLIFY_ONLY
FISH_API_KEY=SET_IN_COOLIFY_ONLY
# Optional 32-hex Fish reference ids for the current hosts (Zabala seat A /
# Mercer seat B). Unset = seed keeps its working-voice fallbacks.
FISH_ZABALA_VOICE_ID=
FISH_CAL_MERCER_VOICE_ID=
# DEPRECATED, one release only. Set FISH_HOST_B_VOICE_ID instead.
# FISH_MULKEY_VOICE_ID=
# Seat-keyed runtime overrides — applied at synthesis, no reseed needed.
FISH_HOST_A_VOICE_ID=
FISH_HOST_B_VOICE_ID=
API_SPORTS_KEY=SET_IN_COOLIFY_ONLY

# Optional APIs (Uncomment and set in .env.coolify.local if needed)
# DEEPGRAM_API_KEY=SET_IN_COOLIFY_ONLY
# BALLDONTLIE_API_KEY=SET_IN_COOLIFY_ONLY
# ODDS_API_KEY=SET_IN_COOLIFY_ONLY
# CARTESIA_API_KEY=SET_IN_COOLIFY_ONLY

# General Production Config (Pre-configured defaults)
NODE_ENV=production
APP_BASE_URL=https://podcast.hopwhistle.com
NEXT_PUBLIC_APP_BASE_URL=https://podcast.hopwhistle.com

# Redis Connection (Internal Coolify Redis URL)
REDIS_URL=redis://default:SET_IN_COOLIFY_ONLY@ydx8y0k0a3mm4zfwk196hiy4:6379

# Storage - Hetzner S3 Object Storage (Helsinki hel1)
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=take-machine-media
S3_PUBLIC_BASE_URL=https://take-machine-media.hel1.your-objectstorage.com

# LLM Config — Anthropic end to end (no OpenAI key needed)
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
SCRIPT_LLM_PROVIDER=anthropic
SCRIPT_LLM_MODEL=claude-opus-5

# Role-based routing. legacy = the configuration above, unchanged. Set both web
# AND worker to the same values, or the two services run different models for
# the same episode.
LLM_ROUTING_PROFILE=legacy
APP_DEPLOYMENT_STAGE=development
# false = comparison mode (default): free candidates fail loudly instead of being
# rescued by paid Anthropic. Set true only for resilient full-pipeline runs.
LLM_ALLOW_LEGACY_FALLBACK=false
# For LLM_ROUTING_PROFILE=frontier_development also set (secrets in Coolify):
#   NVIDIA_API_KEY, ZAI_API_KEY

# Research Config
RESEARCH_PROVIDER=exa

# TTS Config — Fish Audio
# Whole multi-speaker scenes. Both web and worker must carry the same settings.
TTS_RENDER_MODE=auto
TTS_SCENE_PROVIDER_ALLOWLIST=fish,elevenlabs
TTS_PROVIDER=fish
# Fish states that s2.1-pro-free uses the S2.1 Pro model weights and infrastructure.
# The free-tier differences are service terms (SLA, latency, retention and
# commercial conditions), not a documented audio-quality downgrade.
FISH_MODEL=s2.1-pro-free
FISH_SCENE_MODEL=s2.1-pro-free
# Generate several complete performances and select only the strongest candidate
# that passes raw-speech dynamics, phrase-pitch and pacing QA.
FISH_PERFORMANCE_CANDIDATES=3
FISH_SCENE_CHUNK_LENGTH=300
TTS_PERFORMANCE_QA_STRICT=true

# Script quality — fail before database save when the hosts are running parallel
# monologues, ignoring questions, alternating mechanically, collapsing into one
# personality, missing the requested duration, or lacking a real episode arc.
SCRIPT_CONVERSATION_GATE=true
SCRIPT_QUALITY_GATE_STRICT=true

# STT Config
STT_PROVIDER=deepgram
DEEPGRAM_MODEL=nova-3

# Sports & Odds Configs
# Supported SPORTS_PROVIDER: sportsdataio | oddsapi | rss / rss-news (see src/lib/env.ts).
# "api-sports" is NOT implemented and is rejected in production.
SPORTS_PROVIDER=oddsapi
NBA_PROVIDER=balldontlie
ODDS_PROVIDER=theoddsapi
NEWS_PROVIDER=rss
NEWS_RSS_FEEDS=https://www.espn.com/espn/rss/news,https://www.cbssports.com/rss/headlines/

# Podcast RSS Configurations
PODCAST_TITLE=Take Machine
PODCAST_DESCRIPTION=Sports debate shows built from real games, headlines, stats, and betting angles.
PODCAST_LANGUAGE=en-us
PODCAST_AUTHOR=Take Machine
PODCAST_OWNER_NAME=James Kelly
PODCAST_OWNER_EMAIL=jimmy@pvnvoice.com
PODCAST_SITE_URL=https://podcast.hopwhistle.com
PODCAST_RSS_URL=https://podcast.hopwhistle.com/rss
PODCAST_IMAGE_URL=https://take-machine-media.hel1.your-objectstorage.com/assets/take-machine-cover.png
PODCAST_CATEGORY=Sports
PODCAST_SUBCATEGORY=Sports News
PODCAST_EXPLICIT=false
PODCAST_COPYRIGHT=Copyright 2026 Take Machine
PODCAST_TTL=60

RSS_INCLUDE_TRANSCRIPT_LINK=true
RSS_INCLUDE_SHOW_NOTES=true

# Media Processing Gaps
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_LINE_GAP_MS=450
AUDIO_SEGMENT_GAP_MS=850
AUDIO_TOPIC_GAP_MS=1200

# Concurrency (Conservative settings for shared Hetzner Server)
WORKER_CONCURRENCY=1
TTS_WORKER_CONCURRENCY=1
AUDIO_STITCH_WORKER_CONCURRENCY=1
CONTENT_WORKER_CONCURRENCY=1
RSS_WORKER_CONCURRENCY=1

# Security
TRUST_PROXY=true
COOKIE_SECURE=true

# --- User auth (Auth.js / NextAuth v5) for the /app portal ---
# AUTH_SECRET: signing secret. Generate: openssl rand -base64 33
AUTH_SECRET=SET_IN_COOLIFY_ONLY
# Canonical origin (used for OAuth callbacks + secure cookies)
AUTH_URL=https://podcast.hopwhistle.com
# Required behind the reverse proxy so Auth.js trusts the forwarded host
AUTH_TRUST_HOST=true
# Optional: Google OAuth ("Sign in with Google"). Leave unset for email+password only.
AUTH_GOOGLE_ID=SET_IN_COOLIFY_ONLY
AUTH_GOOGLE_SECRET=SET_IN_COOLIFY_ONLY
# Owner/operator accounts (comma-separated emails, case-insensitive): full
# entitlements — no caps, all premium voices — tier ladder untouched for
# everyone else. Accounts with User.role=ADMIN get the same. Set on BOTH
# web and worker.
# OWNER_EMAILS=owner@example.com
# Optional (email flows are stubbed until one of these is set — see src/lib/email/provider.ts)
# RESEND_API_KEY=SET_IN_COOLIFY_ONLY
# EMAIL_FROM=Take Machine <noreply@yourdomain>
