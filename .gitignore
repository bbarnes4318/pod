# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Agent worktrees. These are full nested checkouts of this repo; inside the
# tree they swamp `find`, lint and typecheck with code from other branches.
# Create them OUTSIDE the repo (e.g. C:/pod-worktrees/<name>); this is only a
# backstop for when one lands here anyway.
/.claude/worktrees/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.production.example
!.env.coolify.example
.env.coolify.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated A/B audio samples
/samples/*
# ...except the shipped planner variety-harness artifacts (cue sheets,
# report, before/after renders) - regenerable via npm run demo:sound-variety
!/samples/planner-variety/
ingest-assets/

# LLM contract-probe and role-experiment reports. Machine-generated per run and
# specific to whoever's credentials produced them — a committed copy would be
# read as a durable result long after it stopped being true. Regenerate with
# `npm run probe:llm-contract` / `npm run test:role-experiments`.
/artifacts/*

# Epidemic ingest runtime report (contains prod asset ids)
ingest-report.json
_es_payload.json

# local StorageProvider output (dev fallback for S3)
/public/storage/

# Playwright e2e transient auth state
tests/e2e/.auth/
test-results/
playwright-report/
