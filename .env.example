# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/takemachine?schema=public&connect_timeout=2"

# Redis Configuration (For BullMQ)
REDIS_URL="redis://default:password@localhost:6379"

# S3-Compatible Object Storage
STORAGE_PROVIDER="stub"
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="takemachine-audio"
S3_REGION="us-east-1"
S3_PUBLIC_BASE_URL="http://localhost:9000/takemachine-audio"

# Provider Configurations
# "stub" keeps local dev free; set anthropic to exercise the real pipeline.
LLM_PROVIDER="stub"
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-5"

RESEARCH_PROVIDER="stub"
EXA_API_KEY="your-exa-api-key"

TTS_PROVIDER="stub"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
CARTESIA_API_KEY="your-cartesia-api-key"

# Boson AI TTS (TTS_PROVIDER="boson") — lines are wrapped with Boson inline
# control tokens (<|emotion:X|>, <|prosody:X|>, <|sfx:X|>) automatically.
BOSON_API_KEY="your-boson-api-key"
BOSON_TTS_MODEL="higgs-tts-3"
BOSON_TTS_VOICE="default"
# Seat-keyed voice ids. A is chair 0, B is chair 1, and so on through D.
# Keyed by SEAT so a roster change never silently drops a host onto the
# shared BOSON_TTS_VOICE above.
# BOSON_HOST_A_VOICE_ID=""
# BOSON_HOST_B_VOICE_ID=""
# BOSON_HOST_C_VOICE_ID=""
# BOSON_HOST_D_VOICE_ID=""
# DEPRECATED — use BOSON_HOST_A_/BOSON_HOST_B_VOICE_ID. Read for seats 0 and
# 1 only, until every environment has migrated.
# BOSON_MAX_VOLTAGE_VOICE_ID=""
# BOSON_DR_LINEBREAK_VOICE_ID=""
# Optional voice cloning reference:
# BOSON_TTS_REF_AUDIO=""
# BOSON_TTS_REF_TEXT=""

# Fish Audio TTS (TTS_PROVIDER="fish") — direction, multi-take auditions and
# QA work with either tier. The free development model remains the default;
# promote explicitly after your own blinded/live canary results justify it.
FISH_API_KEY="your-fish-audio-api-key"
FISH_MODEL="s2.1-pro-free"
FISH_SCENE_MODEL_TIER="free" # free | pro; FISH_SCENE_MODEL overrides either
# FISH_SCENE_MODEL="s2.1-pro"
# Optional voice ids (Fish reference_id, 32-hex); omit for the default voice.
# FISH_TTS_VOICE is the SHARED default — a host reaching it logs a warning,
# because every host on this provider then sounds identical.
# FISH_TTS_VOICE=""
# FISH_HOST_A_VOICE_ID=""
# FISH_HOST_B_VOICE_ID=""
# FISH_HOST_C_VOICE_ID=""
# FISH_HOST_D_VOICE_ID=""
# SEED-TIME voice ids, keyed by host identity rather than seat. Read once by
# prisma/seed.ts when the row is written; the HOST_A/HOST_B vars above override
# at synthesis time without a reseed. Publishing hard-fails on the placeholder.
# FISH_ZABALA_VOICE_ID=""
# FISH_CAL_MERCER_VOICE_ID=""
# DEPRECATED — use FISH_HOST_A_/FISH_HOST_B_VOICE_ID. Seats 0 and 1 only.
# FISH_MULKEY_VOICE_ID=""      (retired seat-B host; read for one release)
# FISH_MAX_VOLTAGE_VOICE_ID=""
# FISH_DR_LINEBREAK_VOICE_ID=""

# ElevenLabs / Cartesia / OpenAI follow the same seat-keyed scheme:
# ELEVENLABS_HOST_A_VOICE_ID=""   (shared default: ELEVENLABS_VOICE_ID)
# ELEVENLABS_HOST_B_VOICE_ID=""
# CARTESIA_HOST_A_VOICE_ID=""     (shared default: CARTESIA_VOICE_ID)
# CARTESIA_HOST_B_VOICE_ID=""
# OPENAI_HOST_A_VOICE_ID=""       (shared default: OPENAI_TTS_VOICE)
# OPENAI_HOST_B_VOICE_ID=""
# DEPRECATED equivalents, seats 0 and 1 only:
# ELEVENLABS_MAX_VOLTAGE_VOICE_ID / ELEVENLABS_DR_LINEBREAK_VOICE_ID
# CARTESIA_MAX_VOLTAGE_VOICE_ID   / CARTESIA_DR_LINEBREAK_VOICE_ID
# OPENAI_MAX_VOLTAGE_VOICE        / OPENAI_DR_LINEBREAK_VOICE

# A host's own voice can also be pinned by slug, which beats every seat var:
# FISH_VOICE_ID_BERNIE_LINE_TWO=""
# FISH_VOICE_ID_RAY_FORTY_ONE=""

SPORTS_PROVIDER="oddsapi"
ODDS_API_KEY=""
NEWS_PROVIDER="rss"
# Comma-separated news feeds. Leave UNSET to use the verified sport-specific
# defaults (ESPN/CBS/Yahoo per-league feeds — see DEFAULT_NEWS_RSS_FEEDS in
# src/lib/env.ts). Setting this OVERRIDES the defaults entirely.
NEWS_RSS_FEEDS=""

# Podcast RSS & Feed Configurations
PODCAST_TITLE="Take Machine"
PODCAST_DESCRIPTION="AI-powered sports debate podcasts built from approved, fact-checked sports research."
PODCAST_LANGUAGE="en-us"
PODCAST_AUTHOR="Take Machine"
PODCAST_OWNER_NAME="Take Machine"
PODCAST_OWNER_EMAIL="owner@takemachine.com
PODCAST_SITE_URL="http://localhost:3000"
PODCAST_RSS_URL="http://localhost:3000/rss"
PODCAST_IMAGE_URL="http://localhost:3000/storage/podcast-cover.jpg"
PODCAST_CATEGORY="Sports"
PODCAST_SUBCATEGORY="Sports News"
PODCAST_EXPLICIT="false"
PODCAST_COPYRIGHT="Copyright Take Machine"
PODCAST_TTL="60"
RSS_INCLUDE_TRANSCRIPT_LINK="true"
RSS_INCLUDE_SHOW_NOTES="true"
RSS_PREVIEW_TOKEN="super-secret-preview-token"

# Media
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Conversational timing (all jittered ±AUDIO_GAP_JITTER so no two gaps match)
AUDIO_PAUSE_NONE_MS="80"        # quick reactions / comebacks
AUDIO_PAUSE_BEAT_MS="300"       # normal turn-taking
AUDIO_PAUSE_BREATH_MS="650"     # thought pivots
AUDIO_PAUSE_LONG_MS="1100"      # dramatic beats
AUDIO_SEGMENT_GAP_MS="850"      # between script segments
AUDIO_TOPIC_GAP_MS="1200"       # before a new topic
AUDIO_INTERRUPT_OVERLAP_MS="320" # how far an interruption bites into the previous line
AUDIO_GAP_JITTER="0.35"
# Shared acoustic space & production
AUDIO_ROOM_TONE_DB="-58"        # continuous room-tone bed; <=-100 disables
AUDIO_STEREO_SPREAD="0.14"      # hosts seated slightly left/right; 0 = mono-centered
AUDIO_MUSIC_CROSSFADE_MS="900"  # intro/outro music crossfade
AUDIO_QA_STRICT="false"         # true = fail the stitch job if human-ness QA fails
# Script generation delivery
# NOTE: SCRIPT_GEN_TEMPERATURE is IGNORED on Opus 4.7+, Opus 5, Sonnet 5 and
# Fable 5 — those models reject sampling params with a 400, so the provider
# does not send it. Steer variety from the persona prompt, not this knob.
SCRIPT_GEN_TEMPERATURE="0.85"
SCRIPT_GEN_MAX_TOKENS="16000"
# Independent listener-facing editorial gate: off | observe | hold.
# Default: hold in production, observe elsewhere.
SCRIPT_EDITORIAL_GATE_MODE=""
SCRIPT_EDITORIAL_DETERMINISTIC_REVIEW="72"
SCRIPT_EDITORIAL_DETERMINISTIC_HOLD="50"
SCRIPT_EDITORIAL_JUDGE_REVIEW="78"
SCRIPT_EDITORIAL_JUDGE_HOLD="60"
SCRIPT_EDITORIAL_AXIS_REVIEW="7"
SCRIPT_EDITORIAL_AXIS_HOLD="4.5"
SCRIPT_EDITORIAL_HOLD_OVERRIDE="false"
# ElevenLabs production auditions multiple dialogue takes and selects the best.
ELEVENLABS_PERFORMANCE_QA_ENABLED=""
ELEVENLABS_DIALOGUE_CANDIDATES=""
FISH_PERFORMANCE_CANDIDATES=""
# Separate character writers run after movement repair. Set false only for an
# emergency rollback; disabling this intentionally returns to shared prose.
SCRIPT_CHARACTER_WRITER_PASSES="true"
# Meaning-aware post-render QA (diarized ASR against the approved transcript).
# Keep disabled until an OpenAI key and the live-provider canary are configured.
TTS_TRANSCRIPT_QA_ENABLED="false"
TTS_TRANSCRIPT_QA_STRICT="false"
TRANSCRIPT_QA_PROVIDER="openai"
TRANSCRIPT_QA_MODEL="gpt-4o-transcribe-diarize"
# Optional dedicated key; otherwise OPENAI_API_KEY is used.
TRANSCRIPT_QA_OPENAI_API_KEY=""
# Change in production so privacy-safe session hashes are environment-specific.
ANALYTICS_HASH_SALT=""

# Optional: use a stronger model just for script WRITING (dialogue quality is
# extremely model-sensitive). Falls back to LLM_PROVIDER / its default model.
SCRIPT_LLM_PROVIDER=""
SCRIPT_LLM_MODEL=""
# Optional effort dial for adaptive-thinking models: low|medium|high|xhigh|max.
# Unset = the API default (high). Lower it to cut spend on script:acts.
LLM_EFFORT=""
# VERIFICATION model (self-verify grounding rewrites + the semantic fact-check
# reviewer): structured grading against supplied evidence, so it runs on a
# cheaper model than the writer. Defaults to claude-sonnet-5 when the chain
# resolves to Anthropic; override here.
VERIFY_LLM_PROVIDER=""
VERIFY_MODEL=""
# Extra max_tokens cap headroom for adaptive-thinking models (thinking tokens
# count against max_tokens; without headroom long thinking truncates JSON).
LLM_THINKING_HEADROOM_TOKENS="8192"

# =====================================================================
# ROLE-BASED LLM ROUTING
#
# Each production responsibility (topic generation, outline, dialogue,
# verification, fact-check, show notes, ...) is a ROLE that can run on its own
# model. See docs/LLM_ROLE_ROUTING.md for the full map.
#
#   legacy               (DEFAULT) every role uses the grouped LLM_* /
#                        SCRIPT_LLM_* / VERIFY_* configuration above, exactly as
#                        before. Deploying this code changes nothing.
#   verified_development RECOMMENDED for development. Built ONLY from models that
#                        passed the live contract probe. Temporary and NOT a
#                        verdict on quality — see docs/LLM_ROLE_ROUTING.md.
#   frontier_development the DOCUMENTED INTENT: the full frontier model list.
#                        Kept separately so what we want stays readable next to
#                        what this account can currently reach. Models a probe
#                        found unreachable are filtered out of any profile.
#   free_independent     Z.ai's free general-purpose API for the whole chain.
#   custom               only the explicit per-role overrides below.
LLM_ROUTING_PROFILE="legacy"

# Deployment stage — NOT NODE_ENV, because development and staging routinely run
# production builds. development|staging permit hosted trial endpoints silently;
# live still permits them but shows a readiness advisory. Nothing is ever
# auto-disabled or silently re-routed.
APP_DEPLOYMENT_STAGE="development"

# May a role fall back to PAID Anthropic/OpenAI after its free candidates fail?
#
#   false (DEFAULT)  COMPARISON MODE. A role that exhausts its free candidates
#                    FAILS. This is what makes an A/B result trustworthy: a quiet
#                    paid fallback makes a failing free model look like a working
#                    one, and the number you end up trusting came from Anthropic.
#   true             RESILIENT MODE. For full-pipeline runs where finishing the
#                    episode matters more than isolating the candidate. Every paid
#                    call is logged with a full audit record (role, failed free
#                    candidates, failure categories, paid provider/model, reason).
#
# A CONFIGURATION failure (missing key, bad model id) can only cross into a paid
# provider when this is set EXPLICITLY to true — never on an inherited default.
LLM_ALLOW_LEGACY_FALLBACK="false"

# Global model for the "global" legacy family. Unset = the provider's own default
# (ANTHROPIC_MODEL / OPENAI_MODEL), which is the historical behavior.
LLM_MODEL=""

# --- NVIDIA NIM (hosted; free for development, prototyping and evaluation) ---
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_REQUEST_TIMEOUT_MS="240000"
NVIDIA_MAX_RETRIES="2"
# Catalog ids used by the frontier_development profile. Set one of these only if
# NVIDIA renames a model — a wrong id is then a one-variable fix, not a deploy.
NVIDIA_MODEL_DEEPSEEK_FLASH=""   # default deepseek-ai/deepseek-v4-flash
NVIDIA_MODEL_DEEPSEEK_PRO=""     # default deepseek-ai/deepseek-v4-pro
NVIDIA_MODEL_GLM=""              # default z-ai/glm-5.2
NVIDIA_MODEL_NEMOTRON=""         # default nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_MODEL_MISTRAL=""          # default mistralai/mistral-medium-3.5-128b
NVIDIA_MODEL_KIMI=""             # default moonshotai/kimi-k2.6
#
# Reasoning controls are PER MODEL — NVIDIA's models do not share one contract.
# DeepSeek V4 takes chat_template_kwargs.thinking with a NESTED reasoning_effort;
# Nemotron 3 Ultra takes chat_template_kwargs.enable_thinking with a TOP-LEVEL
# reasoning_budget; Mistral Medium 3.5 takes a top-level reasoning_effort (and is
# deliberately left OFF for dialogue); Kimi K2.6 and GLM-5.2 are sent no reasoning
# field at all. See src/lib/providers/llm/nvidiaRequestProfiles.ts.
NVIDIA_REASONING_EFFORT=""              # low|medium|high — overrides the per-role default
# Nemotron thinking-token budget (documented range 256-16384). The code caps any
# budget to half the caller's max_tokens so the answer always keeps headroom.
NVIDIA_NEMOTRON_REASONING_BUDGET=""              # default 4096
NVIDIA_NEMOTRON_REASONING_BUDGET_RESEARCH=""     # research_brief / evidence_extraction
NVIDIA_NEMOTRON_REASONING_BUDGET_VERIFY=""       # script_verification / fact_check
NVIDIA_NEMOTRON_REASONING_BUDGET_JUDGE=""        # quality_judge

# --- Z.ai (GENERAL-PURPOSE API — not the coding-plan endpoint) ---
ZAI_API_KEY=""
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_REQUEST_TIMEOUT_MS="240000"
ZAI_MAX_RETRIES="2"
ZAI_MODEL_GLM_FLASH=""           # default glm-4.7-flash

# --- Dialogue challenger (development comparison; OFF by default) ---
# Re-generates every movement with a second model from byte-identical inputs and
# reports both. The challenger's dialogue NEVER enters the episode.
SCRIPT_CHALLENGER_ENABLED="false"
SCRIPT_CHALLENGER_PROVIDER=""
SCRIPT_CHALLENGER_MODEL=""

# --- Structured output / diagnostics ---
LLM_STRUCTURED_REPAIR_ENABLED="true"  # one schema-repair request before fallback
LLM_LOG_REASONING="false"             # true logs private reasoning text (debug only)

# --- Optional per-role overrides (rung 1; the profile supplies the rest) ---
# TOPIC_GENERATION_LLM_PROVIDER / TOPIC_GENERATION_LLM_MODEL
# TOPIC_CLASSIFICATION_LLM_PROVIDER / TOPIC_CLASSIFICATION_LLM_MODEL
# TOPIC_RANKING_LLM_PROVIDER / TOPIC_RANKING_LLM_MODEL
# RESEARCH_LLM_PROVIDER / RESEARCH_LLM_MODEL
# EVIDENCE_LLM_PROVIDER / EVIDENCE_LLM_MODEL
# SCRIPT_OUTLINE_LLM_PROVIDER / SCRIPT_OUTLINE_LLM_MODEL
# SCRIPT_MOVEMENT_LLM_PROVIDER / SCRIPT_MOVEMENT_LLM_MODEL
# SCRIPT_VERIFY_LLM_PROVIDER / SCRIPT_VERIFY_LLM_MODEL
# SCRIPT_REWRITE_LLM_PROVIDER / SCRIPT_REWRITE_LLM_MODEL
# CONTINUITY_REPORT_LLM_PROVIDER / CONTINUITY_REPORT_LLM_MODEL
# FACT_CHECK_LLM_PROVIDER / FACT_CHECK_LLM_MODEL
# SHOW_NOTES_LLM_PROVIDER / SHOW_NOTES_LLM_MODEL
# EPISODE_METADATA_LLM_PROVIDER / EPISODE_METADATA_LLM_MODEL
# QUALITY_JUDGE_LLM_PROVIDER / QUALITY_JUDGE_LLM_MODEL

# --- Optional cost estimation (per 1M tokens, USD) ---
# The ledger reports estimatedCost: null unless YOU supply rates. It never
# invents a price, and a free trial endpoint always reports null.
# LLM_PRICE_ANTHROPIC_IN="" / LLM_PRICE_ANTHROPIC_OUT=""
# LLM_PRICE_OPENAI_IN=""    / LLM_PRICE_OPENAI_OUT=""

# Security
TRUST_PROXY="true"
COOKIE_SECURE="false"
# Content sourcing quality
CONTENT_GATE_MODE="block"        # block | warn — refuse to write episodes on weak material
CONTENT_GATE_MIN="50"            # minimum average topic talkability (0-100)
TOPIC_MIN_TALKABILITY="35"       # auto-select skips topics scoring below this
RESEARCH_PROVIDER="exa"          # exa | stub — web research for brief enrichment
EXA_API_KEY="your-exa-api-key"
# Anthropic key/model are declared once at the top of this file. To put script
# WRITING on the strongest model while the cheaper stages stay on
# ANTHROPIC_MODEL, set SCRIPT_LLM_PROVIDER="anthropic" and
# SCRIPT_LLM_MODEL="claude-opus-5" in the script generation section above.

# Recurring podcast auto-generation (PART 5 of podcast-creation system)
# Daily time + timezone the scheduler enqueues episodes for recurring
# podcasts due that weekday. Global setting, not per-podcast.
RECURRING_GENERATION_TIME="06:00"
RECURRING_GENERATION_TZ="America/Chicago"

# Post-TTS sound direction (PR 3). Off by default; when 'true', eligible renders
# plan cues after the real dialogue timing is known. See docs/SOUND_DESIGN.md.
POST_TTS_SOUND_DIRECTION_ENABLED=false

# Sound diversity / anti-repetition engine (PR 4). Off by default.
# Modes: off | observe | soft | enforce. Invalid -> fails safe to off.
SOUND_DIVERSITY_ENGINE_ENABLED=false
SOUND_DIVERSITY_ENFORCEMENT_MODE=observe
SOUND_DIVERSITY_SYSTEM_HISTORY_ENABLED=false
