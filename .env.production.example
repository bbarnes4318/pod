# App Config
NODE_ENV=production
APP_BASE_URL=https://podcast.hopwhistle.com
NEXT_PUBLIC_APP_BASE_URL=https://podcast.hopwhistle.com

# Basic Auth
ADMIN_BASIC_AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_IN_COOLIFY_ONLY

# Database & Redis - provided by Coolify Postgres & Redis resources
DATABASE_URL=SET_IN_COOLIFY_ONLY
REDIS_URL=redis://default:SET_IN_COOLIFY_ONLY@ydx8y0k0a3mm4zfwk196hiy4:6379

# Storage - Hetzner S3 Object Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_REGION=hel1
S3_BUCKET=take-machine-media
S3_ACCESS_KEY_ID=SET_YOUR_REAL_KEY_IN_COOLIFY
S3_SECRET_ACCESS_KEY=SET_YOUR_REAL_SECRET_IN_COOLIFY
S3_PUBLIC_BASE_URL=https://take-machine-media.hel1.your-objectstorage.com

# LLM — Anthropic end to end. LLM_PROVIDER covers topics, research briefs,
# topic classification and show notes; SCRIPT_LLM_* (below) overrides the
# script writer only. No OpenAI key is required anywhere in the pipeline.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=SET_IN_COOLIFY_ONLY
ANTHROPIC_MODEL=claude-sonnet-5
# Script writing on Claude Opus 5 — dialogue quality is the most model-
# sensitive stage and script:acts is ~64% of token spend, so the writer gets
# the strongest model while the other stages stay on ANTHROPIC_MODEL.
SCRIPT_LLM_PROVIDER=anthropic
SCRIPT_LLM_MODEL=claude-opus-5
# Verification (grounding rewrites + semantic fact-check reviewer) defaults to
# claude-sonnet-5 on Anthropic chains. Leave empty unless you are tuning cost.
VERIFY_LLM_PROVIDER=
VERIFY_MODEL=

# Research
RESEARCH_PROVIDER=exa
EXA_API_KEY=SET_IN_COOLIFY_ONLY

# TTS primary — Fish Audio
TTS_PROVIDER=fish
FISH_API_KEY=SET_IN_COOLIFY_ONLY
# Two render paths, two model vars. Both have code defaults — leaving them
# unset is safe.
#
#   FISH_SCENE_MODEL  native multi-speaker scenes = the PRIMARY episode path.
#                     Code default s2-pro (the paid production model). The
#                     free-tier model s2.1-pro-free ALSO renders multi-speaker
#                     scenes — verified live 2026-07-25 against the real API
#                     (the older "S2-Pro only" doc claim is outdated).
#   FISH_MODEL        single lines + Character Studio auditions only.
#
# 402 "Insufficient API credit" on every scene: Fish bills API credit
# SEPARATELY from platform credit — fund it at fish.audio/app/developers, or
# run scenes on the free model below until then.
FISH_MODEL=s2.1-pro-free
FISH_SCENE_MODEL=s2.1-pro-free
# Voice ids for the current host pair (Zabala seat A / Mercer seat B). Read
# by prisma/seed.ts; must be 32-hex Fish reference ids. Leave unset to keep
# the working voices the seed falls back to.
#
# SEAT B NEEDS A NEW VOICE. Cal Mercer inherited the previous occupant's voice
# configuration and has not been auditioned on it — see docs/PRODUCTION_ENV.md.
FISH_ZABALA_VOICE_ID=
FISH_CAL_MERCER_VOICE_ID=
# DEPRECATED, one release only. Set FISH_HOST_B_VOICE_ID instead.
# FISH_MULKEY_VOICE_ID=

# Seat-keyed runtime overrides. These do NOT need a reseed — they apply at
# synthesis time and beat the seeded ttsVoiceId only when it is missing or
# invalid. Set them and a roster change can never drop a host onto the shared
# FISH_TTS_VOICE, which is the failure that hid an entire dead host pair.
FISH_HOST_A_VOICE_ID=
FISH_HOST_B_VOICE_ID=
# FISH_HOST_C_VOICE_ID=
# FISH_HOST_D_VOICE_ID=

# TTS backup
CARTESIA_API_KEY=SET_IN_COOLIFY_ONLY
CARTESIA_MODEL=sonic-3.5
CARTESIA_HOST_A_VOICE_ID=ed81fd13-2016-4a49-8fe3-c0d2761695fc
CARTESIA_HOST_B_VOICE_ID=59697755-8cfb-4ccf-9da4-f2201d06b067
# DEPRECATED — use CARTESIA_HOST_A_/CARTESIA_HOST_B_VOICE_ID. Still read for
# seats 0 and 1 so a mid-rollout deploy keeps its voices.
# CARTESIA_MAX_VOLTAGE_VOICE_ID=
# CARTESIA_DR_LINEBREAK_VOICE_ID=

# STT optional QA
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=SET_IN_COOLIFY_ONLY
DEEPGRAM_MODEL=nova-3

# Sports data
# Supported SPORTS_PROVIDER values (see IMPLEMENTED_SPORTS in src/lib/env.ts):
#   sportsdataio (needs SPORTSDATAIO_API_KEY) | oddsapi (needs ODDS_API_KEY) | rss / rss-news (needs NEWS_RSS_FEEDS)
# NOTE: "api-sports" is NOT implemented and is rejected in production — do not use it.
SPORTS_PROVIDER=oddsapi

NBA_PROVIDER=balldontlie
BALLDONTLIE_API_KEY=SET_IN_COOLIFY_ONLY

ODDS_PROVIDER=theoddsapi
ODDS_API_KEY=SET_IN_COOLIFY_ONLY

NEWS_PROVIDER=rss
NEWS_RSS_FEEDS=https://www.espn.com/espn/rss/news,https://www.cbssports.com/rss/headlines/

SPORTSDATAIO_API_KEY=

# Podcast RSS Metadata
PODCAST_TITLE=Take Machine
PODCAST_DESCRIPTION=Sports debate shows built from real games, headlines, stats, and betting angles.
PODCAST_LANGUAGE=en-us
PODCAST_AUTHOR=Take Machine
PODCAST_OWNER_NAME=James Kelly
PODCAST_OWNER_EMAIL=jimmy@pvnvoice.com
PODCAST_SITE_URL=https://podcast.hopwhistle.com
PODCAST_RSS_URL=https://podcast.hopwhistle.com/rss
PODCAST_IMAGE_URL=https://take-machine-media.hel1.your-objectstorage.com/assets/take-machine-cover.png
PODCAST_CATEGORY=Sports
PODCAST_SUBCATEGORY=Sports News
PODCAST_EXPLICIT=false
PODCAST_COPYRIGHT=Copyright 2026 Take Machine
PODCAST_TTL=60
RSS_INCLUDE_TRANSCRIPT_LINK=true
RSS_INCLUDE_SHOW_NOTES=true
RSS_PREVIEW_TOKEN=SET_IN_COOLIFY_ONLY

# Media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Conversational timing (jittered; see .env.example for the full reference)
AUDIO_PAUSE_NONE_MS=80
AUDIO_PAUSE_BEAT_MS=300
AUDIO_PAUSE_BREATH_MS=650
AUDIO_PAUSE_LONG_MS=1100
AUDIO_SEGMENT_GAP_MS=850
AUDIO_TOPIC_GAP_MS=1200
AUDIO_INTERRUPT_OVERLAP_MS=320
AUDIO_GAP_JITTER=0.35
AUDIO_ROOM_TONE_DB=-58
AUDIO_STEREO_SPREAD=0.14
AUDIO_MUSIC_CROSSFADE_MS=900
AUDIO_QA_STRICT=false
SCRIPT_GEN_TEMPERATURE=0.85
SCRIPT_GEN_MAX_TOKENS=16000

# Concurrency limits on shared Hetzner instance
WORKER_CONCURRENCY=1
TTS_WORKER_CONCURRENCY=1
AUDIO_STITCH_WORKER_CONCURRENCY=1
CONTENT_WORKER_CONCURRENCY=1
RSS_WORKER_CONCURRENCY=1

# Security
TRUST_PROXY=true
COOKIE_SECURE=true
# --- User auth (Auth.js / NextAuth v5) for the /app portal ---
# AUTH_SECRET: signing secret. Generate: openssl rand -base64 33
AUTH_SECRET=SET_IN_COOLIFY_ONLY
# Canonical origin (used for OAuth callbacks + secure cookies)
AUTH_URL=https://podcast.hopwhistle.com
# Required behind the reverse proxy so Auth.js trusts the forwarded host
AUTH_TRUST_HOST=true
# Optional: Google OAuth ("Sign in with Google"). Leave unset for email+password only.
AUTH_GOOGLE_ID=SET_IN_COOLIFY_ONLY
AUTH_GOOGLE_SECRET=SET_IN_COOLIFY_ONLY
# Optional (email flows are stubbed until one of these is set — see src/lib/email/provider.ts)
# RESEND_API_KEY=SET_IN_COOLIFY_ONLY
# EMAIL_FROM=Take Machine <noreply@yourdomain>
# Owner/operator accounts (comma-separated emails, case-insensitive): these
# accounts get full entitlements — no episode/podcast caps, all premium voices —
# without touching the tier ladder for real customers. Accounts with
# User.role=ADMIN get the same. Set on BOTH web and worker.
# OWNER_EMAILS=owner@example.com
