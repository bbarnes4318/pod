datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  name          String?
  role          String       @default("USER")
  // Monetization tier (Step 9c). Additive, defaults to "free" for every existing
  // + new account. This single column is the entitlement source of truth a
  // future billing webhook would update — no processor is wired in this step.
  plan          String       @default("free")
  // --- Auth.js additions (all additive/nullable; existing columns unchanged) ---
  emailVerified DateTime? // set when the user confirms their email (email flow is stubbed until a mail provider is configured)
  image         String? // avatar URL (from OAuth or account settings)
  passwordHash  String? // bcrypt hash for the Credentials provider; null for OAuth-only accounts
  accounts      Account[]
  sessions      Session[]
  podcasts      Podcast[] // shows this user owns
  episodes      Episode[] // episodes this user created
  aiHosts       AiHost[] // Character Studio hosts this user owns (null owner = shared)
  audioAssets   AudioAsset[] @relation("OwnedAudioAssets") // private sound library
  studioDraft   StudioDraft? // in-progress Studio rundown (pre-generation resume state)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// --- Auth.js (NextAuth v5) / @auth/prisma-adapter standard tables ---
// Sessions use the JWT strategy (Credentials provider requires it), so the
// Session table is present for adapter compatibility but not the primary
// session store. OAuth (Google) links accounts here.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model AiHost {
  id                  String              @id @default(uuid())
  name                String
  slug                String              @unique
  role                String
  worldview           String
  speakingStyle       String
  catchphrases        Json // Array of strings
  likes               Json // Array of strings
  dislikes            Json // Array of strings
  argumentPatterns    Json // Array of strings or objects
  bannedPhrases       Json // Array of strings
  ttsProvider         String
  ttsVoiceId          String
  intensityLevel      Int
  // Optional versioned performance profile (validated by
  // src/lib/hosts/performanceProfile.ts — never a bag of unchecked JSON).
  // null = derive safely from role/speakingStyle/intensityLevel.
  performanceProfile  Json?
  isActive            Boolean             @default(true)
  // Soft archive (Step 8 Character Studio): archived hosts drop out of active
  // pickers but keep their association with existing episodes. Additive +
  // default false (migration 20260707140000).
  isArchived          Boolean             @default(false)
  // Per-account ownership (additive, nullable, migration 20260707150000).
  // null = system/shared host (existing rows + seed) — visible read-only to
  // every account; non-null = owned by that User.id. Pickers show own + shared;
  // mutations are owner-gated; the resolver stays owner-agnostic.
  ownerId             String?
  ownerUser           User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // Declared so the schema matches what 20260707150000_add_aihost_owner actually
  // built. The pickers filter hosts by owner, so this index is wanted — it was
  // simply never written down here, which showed up as drift the moment a
  // database was rebuilt from migrations. See 20260715170000_reconcile_aihost_owner.
  // Documented voice provenance — the legal-safety fields (cf. Greene v. Google).
  // voiceSource: "owned" | "licensed" | "synthetic" | "cloned" (free-text for now).
  // voiceProvenanceNote: license id / consent record / source documentation.
  // Surfacing + editing is Step 8; the columns exist now so provenance can be
  // recorded. Additive + nullable (migration 20260707130000).
  voiceSource         String?
  voiceProvenanceNote String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  castMemberships     EpisodeCastMember[]

  @@index([ownerId])
}

// Normalized episode cast (Prompt 7): WHICH host sits in WHICH chair of the
// episode's show format. Replaces the bare two-slot Episode.hostIds pair
// assumption (that column stays as a legacy mirror in seat order). Seat 0..3;
// role ids come from the format registry (chair_a, anchor, moderator, ...).
model EpisodeCastMember {
  id         String   @id @default(uuid())
  episodeId  String
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  hostId     String
  host       AiHost   @relation(fields: [hostId], references: [id], onDelete: Restrict)
  role       String // ShowFormatRole.id from the registry
  orderIndex Int // seat order: drives speaking order, seating, colors
  createdAt  DateTime @default(now())

  @@unique([episodeId, orderIndex])
  @@unique([episodeId, hostId])
  @@index([hostId])
}

model SportsDataSource {
  id             String    @id @default(uuid())
  name           String    @unique
  type           String
  baseUrl        String
  isActive       Boolean   @default(true)
  lastIngestedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model League {
  id              String           @id // Custom ID e.g. "NBA", "NFL"
  name            String
  sport           String
  slug            String           @unique
  isActive        Boolean          @default(true)
  teams           Team[]
  players         Player[]
  games           Game[]
  teamStats       TeamStat[]
  playerStats     PlayerStat[]
  topicCandidates TopicCandidate[]
}

model Team {
  id           String       @id // Custom ID e.g. "BOS", "KC"
  leagueId     String
  name         String
  city         String
  abbreviation String
  slug         String       @unique
  league       League       @relation(fields: [leagueId], references: [id])
  players      Player[]
  homeGames    Game[]       @relation("HomeTeam")
  awayGames    Game[]       @relation("AwayTeam")
  teamStats    TeamStat[]
  playerStats  PlayerStat[]
  injuries     Injury[]

  @@index([leagueId])
}

model Player {
  id          String       @id
  leagueId    String
  teamId      String?
  name        String
  position    String?
  status      String?
  league      League       @relation(fields: [leagueId], references: [id])
  team        Team?        @relation(fields: [teamId], references: [id])
  playerStats PlayerStat[]
  injuries    Injury[]

  @@index([leagueId])
  @@index([teamId])
}

model Game {
  id            String         @id
  leagueId      String
  homeTeamId    String
  awayTeamId    String
  scheduledAt   DateTime
  status        String
  homeScore     Int?
  awayScore     Int?
  sourceId      String?
  raw           Json
  league        League         @relation(fields: [leagueId], references: [id])
  homeTeam      Team           @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam      Team           @relation("AwayTeam", fields: [awayTeamId], references: [id])
  oddsSnapshots OddsSnapshot[]

  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([scheduledAt])
}

model TeamStat {
  id         String   @id @default(uuid())
  teamId     String
  leagueId   String
  season     String
  statType   String
  value      Json
  sourceId   String?
  recordedAt DateTime
  team       Team     @relation(fields: [teamId], references: [id])
  league     League   @relation(fields: [leagueId], references: [id])

  @@index([teamId])
  @@index([leagueId])
  @@index([season, statType])
}

model PlayerStat {
  id         String   @id @default(uuid())
  playerId   String
  teamId     String?
  leagueId   String
  season     String
  statType   String
  value      Json
  sourceId   String?
  recordedAt DateTime
  player     Player   @relation(fields: [playerId], references: [id])
  team       Team?    @relation(fields: [teamId], references: [id])
  league     League   @relation(fields: [leagueId], references: [id])

  @@index([playerId])
  @@index([teamId])
  @@index([leagueId])
  @@index([season, statType])
}

model Injury {
  id          String   @id @default(uuid())
  playerId    String
  teamId      String?
  status      String?
  description String?
  reportedAt  DateTime
  sourceId    String?
  sourceUrl   String?
  player      Player   @relation(fields: [playerId], references: [id])
  team        Team?    @relation(fields: [teamId], references: [id])

  @@index([playerId])
  @@index([teamId])
}

model OddsSnapshot {
  id                 String   @id @default(uuid())
  gameId             String
  sportsbook         String
  market             String
  line               Float?
  price              Float?
  impliedProbability Float?
  capturedAt         DateTime
  sourceId           String?
  raw                Json
  game               Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
  @@index([sportsbook])
  @@index([capturedAt])
}

model NewsItem {
  id          String   @id @default(uuid())
  title       String
  source      String
  url         String
  publishedAt DateTime
  summary     String?
  entities    Json // Array of extracted entities/keywords
  raw         Json

  @@index([publishedAt])
}

// Editorial-readiness lifecycle for a topic candidate. Deliberately does NOT
// include a "used" state: usage is derived from EpisodeTopic.
enum TopicEditorialStatus {
  pending
  approved
  rejected
  archived
}

model TopicCandidate {
  id                    String               @id @default(uuid())
  title                 String
  sport                 String
  leagueId              String?
  summary               String?
  controversyScore      Float
  starPowerScore        Float
  bettingRelevanceScore Float
  recencyScore          Float
  debateScore           Float
  /// The eight-axis editorial judgment that produced editorialScore. Stored so
  /// ranking changes are explainable and can be learned from retention later.
  editorialScores       Json?
  editorialScore        Float                @default(0)
  evidenceIds           Json // Structured logs linking back to Games/Stats/News
  // EDITORIAL READINESS ONLY — never a global usage flag. Usage is derived from
  // EpisodeTopic (a topic can be consumed by many users/podcasts/episodes).
  // Enforced at the DB level as an enum so "used"/arbitrary values can't be
  // written through Prisma.
  status                TopicEditorialStatus
  // Is this topic FRAMED around betting, or does it merely cite odds as a fact?
  // Stored on the row, not computed at display time: the quota is enforced at
  // GENERATION (a display-time filter would keep producing them and just hide
  // the result), and a stored value is what makes "1 per rolling 30 days"
  // answerable with a query. "human" | "betting".
  frame                 String               @default("human")
  /// Weighted evidence behind `frame`, kept so a classification can be explained.
  frameScore            Int                  @default(0)
  /// Which frame patterns fired, for auditing a disputed classification.
  frameSignals          Json?
  createdAt             DateTime             @default(now())
  league                League?              @relation(fields: [leagueId], references: [id])
  researchBrief         ResearchBrief?
  episodeTopics         EpisodeTopic[]
  sources               TopicSource[] // operator-imported articles (editorial input, NOT evidence)

  @@index([leagueId])
  @@index([status])
  @@index([createdAt])
  @@index([editorialScore])
  // The quota query: betting-framed topics created inside a rolling window.
  @@index([frame, createdAt])
}

// An article an operator imported by URL as editorial STARTING MATERIAL for a
// topic. Deliberately NOT evidence: nothing here is verified, so importing a
// source never touches TopicCandidate.evidenceIds (which the pipeline writes
// only after existence-checking each ref) and never satisfies a research gate.
// A topic with sources but no research still reports missing evidence/brief.
//
// WHY A NEW MODEL: NewsItem is the RSS ingest artifact — it has no topic
// relation, no content hash, no fetch outcome, no canonical URL, no importing
// operator, and is read by topic generation. Writing operator imports into it
// would both lose the fields below and quietly feed the automatic topic
// generator. Injury.sourceUrl is the only other URL column and is unrelated.
model TopicSource {
  id                     String    @id @default(uuid())
  topicId                String
  // As pasted (minus any credentials, which are rejected before we get here).
  originalUrl            String
  // Post-redirect, normalized. The duplicate-detection key.
  canonicalUrl           String
  title                  String?
  publisher              String?
  author                 String?
  publishedAt            DateTime?
  // Sanitized PLAIN TEXT only. Raw HTML is never stored: it has no consumer,
  // and storing it would keep an XSS payload alive in the database.
  excerpt                String?
  // sha256 of the fetched body — cheap change detection without keeping it.
  contentHash            String?
  // "imported" | one of the FetchErrorCategory values.
  fetchStatus            String
  fetchErrorCategory     String?
  retrievedAt            DateTime?
  // adminIdentity() — an audit label, NOT a User FK (admins have no User row).
  createdByAdminIdentity String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  topic TopicCandidate @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // The same article can't be imported onto the same topic twice.
  @@unique([topicId, canonicalUrl])
  @@index([topicId])
  @@index([canonicalUrl])
}

model ResearchBrief {
  id               String         @id @default(uuid())
  topicId          String         @unique
  facts            Json // Scraped facts/bulletpoints
  stats            Json // Relevant statistics
  injuryContext    String?
  oddsContext      String?
  argumentForHostA String
  argumentForHostB String
  counterArguments Json // Counter arguments structure
  unsafeClaims     Json // Moderated/flagged points
  sourceIds        Json // List of source URLs/IDs
  createdAt        DateTime       @default(now())
  topic            TopicCandidate @relation(fields: [topicId], references: [id], onDelete: Cascade)

  // Decoupled editorial fields
  classification          String?
  mainAngle               String?
  whyMattersNow           String?
  keyFactsContext         Json?
  onAirTalkingPoints      Json?
  contrarianAngle         String?
  strongestDebateQuestion String?
  suggestedHostTake       String?
  sourceNotesUsed         String?
}

// A user-defined show: the saved recipe (verticals, teams, hosts, segment
// count, cadence) that episodes are generated from — one-time or recurring.
model Podcast {
  id                    String   @id @default(uuid())
  name                  String
  cadence               String // "one_time" | "recurring"
  scheduleDays          String[] @default([]) // ["mon".."sun"] — recurring only
  verticals             String[] @default([]) // display names from src/lib/verticals.ts (e.g. "NFL", "College Football")
  teams                 String[] @default([]) // Team.id values; empty = vertical-wide
  segmentCount          Int      @default(3) // maps to the pipeline's targetTopicCount
  hostIds               String[] @default([]) // AiHost.id values
  owner                 String   @default("listener") // legacy free-text owner; superseded by ownerId
  ownerId               String? // User.id of the creator; null for legacy/pre-auth podcasts
  ownerUser             User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  // "YYYY-MM-DD" in the scheduler TZ — atomic idempotency claim so a re-run
  // of the daily scheduler never double-generates (see recurring scheduler).
  lastAutoGeneratedDate String?

  // --- Canonical show identity (Prompt 5) --------------------------------
  // A show is a saved, versioned configuration. These fields are the show's
  // public identity; the editorial/production/publishing *settings* live in
  // the three 1-1 config tables below. See docs/PODCAST_CONFIGURATION.md.
  slug          String? @unique // URL-safe, normalized, reserved-name-rejecting; null only until backfilled
  description   String?
  author        String? // shown as the RSS <itunes:author> / channel author
  ownerName     String? // owner display name (distinct from the legacy free-text `owner`)
  ownerEmail    String? // SENSITIVE: contact email for the feed owner. Never returned by list APIs and never written into an Episode snapshot.
  websiteUrl    String?
  language      String  @default("en") // RSS channel language (BCP-47)
  category      String? // Apple Podcasts primary category
  subcategory   String? // Apple Podcasts subcategory
  explicit      Boolean @default(false) // channel-level explicit default
  copyright     String?
  coverImageUrl String?
  visibility    String  @default("private") // "private" | "unlisted" | "public" — private != token feed; see Prompt 8 (deferred)
  // Bumped on every accepted configuration change (optimistic concurrency).
  configVersion Int     @default(1)

  editorialConfig  PodcastEditorialConfig?
  productionConfig PodcastProductionConfig?
  publishingConfig PodcastPublishingConfig?
  continuity       ShowContinuity?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  episodes    Episode[]
  audioAssets AudioAsset[] // podcast-private sound assets

  @@index([cadence])
  @@index([ownerId])
  @@index([visibility])
}

// One-to-one editorial settings: WHAT a show covers and HOW its script is shaped.
// Kept normalized (not JSON) so the resolver validates each field and migrations
// can reason about them. See docs/PODCAST_CONFIGURATION.md.
model PodcastEditorialConfig {
  id             String   @id @default(uuid())
  podcastId      String   @unique
  podcast        Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  verticals      String[] @default([]) // mirrors Podcast.verticals during transition; resolver reads this
  teams          String[] @default([]) // Team.id values
  segmentCount   Int      @default(3) // pipeline targetTopicCount
  format         String   @default("two_host_debate") // ONLY two_host_debate is supported (Prompt 7 deferred)
  minDebateScore Int? // real TopicCandidate.debateScore floor; null = pipeline default
  scriptStyle    String? // Advanced Producer scriptStyle (real)
  maxWords       Int? // Advanced Producer maxWords (real)
  // Closed-loop, bounded show-specific learning. Stores measured retention and
  // soft cold-open archetype priors; never rewrites host identity or evidence
  // rules, and every update is versioned/auditable.
  learningPolicy        Json?
  learningPolicyVersion Int      @default(1)
  learningPolicyUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One-to-one production settings: voices and post-production.
model PodcastProductionConfig {
  id                String   @id @default(uuid())
  podcastId         String   @unique
  podcast           Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  hostIds           String[] @default([]) // AiHost.id values; generation supports at most 2
  ttsProvider       String? // voice engine override; null = fall through host/env
  ttsVoiceOverrides Json? // per-host voice picks, same shape as Episode.ttsVoiceOverrides
  productionStyle   String? // sound design style: "clean" | "light" | "full"
  sfxDensity        String? // sound design sfx density

  // --- Sound profile (Prompt 6) ------------------------------------------
  // "system_default": the shared system profile, FROZEN into each Episode's
  //   snapshot at creation (a later system edit never changes that Episode).
  // "custom": this Podcast's explicit PodcastSoundAssignment rows.
  // "clean": dialogue only — no intro/outro/bed/stingers/reactions.
  soundProfileMode         String  @default("system_default")
  targetLoudnessLufs       Float? // master loudness target; null = pipeline default (-16)
  // Cue anti-repetition scope: "podcast" (default — only THIS show's prior
  // usage counts) or "owner" (all of this owner's shows). NEVER global:
  // another customer's usage must not influence this show's rotation.
  cooldownScope            String  @default("podcast")
  stingerCooldownEpisodes  Int? // null = pipeline default
  reactionCooldownEpisodes Int? // null = pipeline default
  defaultIntroEnabled      Boolean @default(true)
  defaultOutroEnabled      Boolean @default(true)

  // --- Sonic identity (PR 2) ---------------------------------------------
  // The producer's declared, versioned creative identity for THIS show
  // (validated JSON: genre/moods/pace/intensity/broadcastStyle, allowed &
  // prohibited cue families, format restrictions, bed & voice-over-music
  // policy, music-gap bounds). null = the permissive default (unchanged
  // behavior). See src/lib/audio/sonicIdentity.ts.
  sonicIdentity Json?

  // --- Diversity policy (PR 4) -------------------------------------------
  // Per-podcast anti-repetition policy OVERRIDES (a bounded Partial<Sound
  // DiversityPolicy>). null = code/env defaults (unchanged behavior). Every
  // numeric field is clamped to its bound on save + on resolve, so a bad value
  // can never take effect. Not fingerprinted here — the RESOLVED policy is
  // frozen into each Episode's v6 snapshot at creation.
  diversityPolicy Json?

  soundAssignments PodcastSoundAssignment[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
}

// Normalized Podcast sound assignment (Prompt 6; VARIANT POOLS in PR 2): which
// asset voices which role for a show. As of PR 2 EVERY role (intro/outro/bed/
// stinger/reaction) is a POOL of weighted, ordered VARIANTS — the old
// one-enabled-intro/outro/bed singleton index is dropped so a show can rotate
// among a coherent brand family. Entries are still deduped per
// (podcast, role, asset). A variant carries a cue family, a bounded weight, an
// optional branded-motif flag, per-episode use/cooldown limits, and optional
// per-assignment format allow/deny lists.
model PodcastSoundAssignment {
  id                  String                  @id @default(uuid())
  productionConfigId  String
  productionConfig    PodcastProductionConfig @relation(fields: [productionConfigId], references: [id], onDelete: Cascade)
  podcastId           String // denormalized for direct scoping queries + constraints
  assetId             String
  asset               AudioAsset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  role                String // "intro" | "outro" | "bed" | "stinger" | "reaction"
  orderIndex          Int                     @default(0) // deterministic pool ordering
  enabled             Boolean                 @default(true)
  gainDb              Float? // bounded trim; null = neutral
  fadeInMs            Int?
  fadeOutMs           Int?
  // --- Variant pool metadata (PR 2) --------------------------------------
  cueFamily           String? // creative purpose (see sonicIdentity.ts); must be valid for role
  weight              Float                   @default(1) // bounded [0,100]; deterministic selection weight
  isBrandedMotif      Boolean                 @default(false)
  maxUsesPerEpisode   Int? // null = pipeline default
  minEpisodeCooldown  Int? // null = pipeline default
  allowedFormatIds    String[]                @default([]) // empty = all formats
  prohibitedFormatIds String[]                @default([])
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@unique([podcastId, role, assetId]) // no duplicate pool entries
  @@index([podcastId, role])
  @@index([podcastId, role, enabled])
  @@index([assetId])
}

// One row per audio RENDER of an episode (Prompt 6): initial mix, reproduce,
// or remix. The Podcast configuration snapshot says what was PERMITTED; this
// record (plus its SoundCueUsage rows) says what actually HAPPENED — and a
// later asset/profile edit can never rewrite it.
model EpisodeAudioRender {
  id                       String          @id @default(uuid())
  episodeId                String
  episode                  Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scriptId                 String?
  renderVersion            Int // 1, 2, ... per episode
  status                   String // "running" | "succeeded" | "failed"
  renderMode               String // "initial" | "reproduce" | "remix_episode_profile" | "remix_current_podcast" | "legacy"
  plannerSeed              Int?
  productionStyle          String?
  sfxDensity               String?
  targetLoudnessLufs       Float?
  configurationFingerprint String? // Episode configuration fingerprint at render time
  plan                     Json? // the exact ProductionPlan executed — the reproduce-mode source of truth
  diagnostics              Json? // safe per-render cue-sheet report (RenderDiagnostics) — names/ids/reasons/bookend result only, never URLs/keys
  outputAudioUrl           String? // final master reference (existing Episode.audioUrl value)
  failureReason            String? // safe category only — never URLs/keys/commands
  startedAt                DateTime        @default(now())
  completedAt              DateTime?
  createdAt                DateTime        @default(now())
  usages                   SoundCueUsage[]

  @@unique([episodeId, renderVersion])
  @@index([episodeId])
  @@index([status])
}

// One-to-one publishing policy: which auto-assets are produced and whether
// downloads are enabled. Channel metadata (title/language/category/explicit)
// lives on Podcast; this table is per-show publishing behavior. Nothing here
// enables private feeds (Prompt 8 deferred) — /rss stays as-is.
model PodcastPublishingConfig {
  id                    String   @id @default(uuid())
  podcastId             String   @unique
  podcast               Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  autoGenerateChapters  Boolean  @default(true)
  autoGenerateShowNotes Boolean  @default(true)
  autoGenerateCover     Boolean  @default(true)
  includeTranscript     Boolean  @default(true)
  downloadsEnabled      Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Episode {
  id                          String               @id @default(uuid())
  title                       String
  slug                        String               @unique
  // Canonical ladder + the produced-or-later boundary live in
  // src/lib/episodeStatus.ts (EPISODE_STATUS_LADDER / PRODUCED_OR_LATER).
  // In pipeline order:
  //   draft -> script_draft -> fact_checked -> script_approved ->
  //   audio_segments_ready -> audio_stitching -> audio_ready ->
  //   content_generating -> content_ready -> publish_ready -> published
  // plus "failed", which is off-ladder and reachable from anywhere.
  // There is NO "completed" Episode status. The previous comment here claimed
  // one, and that error propagated into a design decision before anyone
  // checked. Import the constant; never re-derive this list from a literal.
  status                      String
  description                 String?
  longShowNotes               String?
  durationSeconds             Int?
  audioUrl                    String?
  transcriptUrl               String?
  rssGuid                     String?              @unique
  publishedAt                 DateTime?
  episodeNumber               Int?
  seasonNumber                Int?
  explicit                    Boolean              @default(false)
  rssSummary                  String?
  rssSubtitle                 String?
  rssImageUrl                 String?
  audioFileSizeBytes          Int?
  audioMimeType               String               @default("audio/mpeg")
  ttsProvider                 String? // Voice engine chosen at build time ("fish", "boson", ...); null = fall through to host/env. See docs/TTS_PROVIDERS.md
  ttsVoiceOverrides           Json? // Per-host voice picks keyed by host slug: { "max-voltage": { provider, voiceId, voiceName? }, ... }. See docs/TTS_PROVIDERS.md
  // How this episode's SPOKEN audio was generated — persisted at generation
  // time, never inferred later from whichever env vars happen to exist.
  // "legacy_line" | "scene" | "mixed_fallback" | "performance_conversion";
  // null = generated before scene mode existed (legacy line pipeline).
  ttsRenderMode               String?
  soundDesign                 Json? // Post-production settings: { style, sfxDensity, highlights: [{lineIndex, assetId}] }. See docs/SOUND_DESIGN.md
  // What this episode CLAIMED about the show's running bits — the validated
  // ContinuityUpdate, written when fact-check passes. Attached to the episode
  // that claimed it, so ShowContinuity can be re-derived by folding these in
  // order. That makes the ShowContinuity row a CACHE rather than the truth: a
  // failed generation, a deleted episode, or a bug in the increment logic is
  // recoverable instead of permanent drift. See showContinuityService.ts.
  continuityUpdate            Json?
  // The pre-Cal (Dutch Mulkey) continuity claim, moved here by migration
  // 20260727000000 so the fold can never see a claim in the retired shape.
  // Leaving those claims in `continuityUpdate` would have made every fold log a
  // "no longer validates" warning for every historical episode, forever, and
  // would have kept retired running-bit state one schema change away from
  // reaching a prompt. Retained for one release for rollback; nothing reads it.
  legacyContinuityUpdate      Json?
  podcastId                   String? // Nullable — pre-existing episodes have no podcast
  ownerId                     String? // User.id of the creator; null for legacy/pre-auth episodes
  hostIds                     String[]             @default([]) // LEGACY compat: AiHost.id list in seat order; canonical cast = castMembers (Prompt 7)
  // --- Show format (Prompt 7) --------------------------------------------
  // Which registered format built this episode. two_host_debate is the
  // backfilled value for every pre-format episode — that IS what built them.
  formatId                    String               @default("two_host_debate")
  castMembers                 EpisodeCastMember[]
  // --- Immutable configuration snapshot (Prompt 5) -----------------------
  // Frozen at creation so a later edit to the Podcast can never rewrite how a
  // finished episode was built. See src/lib/services/episodeConfigurationSnapshot.ts.
  configurationSource         String               @default("legacy") // "podcast" | "standalone" | "legacy"
  podcastConfigurationVersion Int? // Podcast.configVersion captured at snapshot time (podcast episodes only)
  configurationSnapshot       Json? // versioned, deterministic, secret-free resolved config
  configurationFingerprint    String? // sha256 of the canonicalized snapshot
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  podcast                     Podcast?             @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  ownerUser                   User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  topics                      EpisodeTopic[]
  scripts                     Script[]
  audioSegments               AudioSegment[]
  socialClips                 SocialClip[]
  audioRenders                EpisodeAudioRender[]
  dialogueScenes              DialogueSceneAudio[]

  playEvents PlayEvent[]
  listenerSignals ListenerSignal[]

  @@index([status])
  @@index([publishedAt])
  @@index([podcastId])
  @@index([ownerId])
}

model EpisodeTopic {
  id         String         @id @default(uuid())
  episodeId  String
  topicId    String
  orderIndex Int
  // IMMUTABLE snapshot of the topic + research brief AS SELECTED, so an episode
  // stays reproducible even if the source topic/brief is later edited. Shape:
  // src/lib/services/topicSnapshot.ts EpisodeTopicSnapshot. Nullable for legacy
  // rows until the backfill runs; readers fall back to live topic data.
  snapshot   Json?
  // When this topic was selected into the episode — also the "used" timestamp
  // that derived usage + cooldown policies read.
  selectedAt DateTime       @default(now())
  episode    Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  topic      TopicCandidate @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([episodeId, topicId])
  @@index([episodeId])
  @@index([topicId])
  @@index([selectedAt])
}

// Durable, cross-session resume state for the Studio multi-topic rundown BUILDER
// (pre-generation: before an Episode exists). Stores the full editor state so a
// producer can close the tab / switch machines and resume with every topic,
// ordering, mode, host, and production setting intact. One active draft per
// user; cleared once the episode is created. NEVER holds a generated episode's
// immutable topic snapshots — those live on EpisodeTopic.
model StudioDraft {
  id        String   @id @default(uuid())
  ownerId   String   @unique // one resumable Studio rundown per user
  state     Json // RundownDraftState (src/lib/services/studioDraft.ts)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerUser User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// Resumable ADMIN rundown. Deliberately NOT a StudioDraft row and deliberately
// WITHOUT a User relation: /admin authenticates via HTTP Basic Auth against
// env vars (src/lib/adminAuth.ts adminIdentity()), so an admin operator has no
// User row to foreign-key against. StudioDraft.ownerId is a REQUIRED FK to
// User(id), so reusing it for an admin identity would fail at insert. This
// follows the JobLog precedent: operator-authored state keyed by the audited
// admin identity string, carrying the SAME RundownDraftState JSON blob Studio
// persists (src/lib/services/studioDraft.ts) so the two surfaces cannot drift.
model AdminDraft {
  id        String   @id @default(uuid())
  adminId   String   @unique // adminIdentity() — one resumable rundown per operator
  state     Json // RundownDraftState (same schema as StudioDraft.state)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model Script {
  id               String               @id @default(uuid())
  episodeId        String
  version          Int
  content          Json // Lines format: [{hostId, text, stageDirection}]
  plainText        String?
  status           String // "draft" | "generating" | "ready" | "failed"
  createdAt        DateTime             @default(now())
  episode          Episode              @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  factCheckResults FactCheckResult[]
  audioSegments    AudioSegment[]
  dialogueScenes   DialogueSceneAudio[]

  @@index([episodeId])
  @@index([status])
}

model FactCheckResult {
  id               String   @id @default(uuid())
  scriptId         String
  passed           Boolean
  warnings         Json // Array of warning objects
  errors           Json // Array of error objects
  createdAt        DateTime @default(now())
  script           Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  episodeId        String?
  status           String   @default("needs_review") // "passed" | "failed" | "needs_review"
  checkedAt        DateTime @default(now())
  provider         String   @default("deterministic")
  summary          Json?
  issues           Json?
  evidenceCoverage Json?
  rawResult        Json?

  @@index([scriptId])
}

model AudioSegment {
  id               String   @id @default(uuid())
  episodeId        String
  scriptId         String
  hostId           String? // References host profile who spoke it
  lineIndex        Int
  text             String
  audioUrl         String?
  durationMs       Int?
  status           String // "pending" | "processing" | "ready" | "failed"
  provider         String?
  providerMetadata Json?
  createdAt        DateTime @default(now())
  episode          Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  script           Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([scriptId])
  @@index([lineIndex])
}

// One SCENE generation of dialogue audio (native multi-speaker TTS). ADDITIVE
// next to AudioSegment — legacy per-line rows are never repurposed or
// destroyed; an episode's ttsRenderMode records which pipeline voiced it.
// Candidates: each (scene, candidateIndex) generation persists separately and
// exactly one row per scene may be selected for the final stitch.
model DialogueSceneAudio {
  id                 String   @id @default(uuid())
  episodeId          String
  scriptId           String
  sceneIndex         Int
  sceneType          String // cold_open | conversation | argument_escalation | ... (DialogueSceneType)
  firstLineIndex     Int
  lastLineIndex      Int
  lineIndexes        Json // number[] — every APPROVED line this scene performs, in order
  provider           String // "elevenlabs" | "fish" | ...
  model              String // exact model id used (e.g. "eleven_v3", "s2-pro")
  renderUnit         String // "multi_speaker_scene" | "speaker_turn_cluster" | "single_line" (oversized fallback)
  voiceMap           Json // { [hostId]: voiceId } actually sent (never keys/secrets)
  requestFingerprint String // sha256 over approved text + speakers + provider/model/voices/settings/seed + versions
  candidateIndex     Int      @default(0)
  seed               Int?
  status             String // "pending" | "processing" | "ready" | "failed"
  audioUrl           String?
  durationMs         Int?
  contentType        String?
  providerMetadata   Json? // secret-free (request ids, voice order, cue preview)
  timingStatus       String   @default("timing_unavailable") // provider_timestamps | forced_alignment | stt_alignment | timing_unavailable
  timingMap          Json? // [{ lineIndex, sceneId, startMs, endMs, speakerHostId }] — never fabricated
  errorCategory      String? // safe taxonomy (sceneTypes.SceneErrorCategory)
  selected           Boolean  @default(false) // the candidate the final stitch uses (max one per scene)
  continuationRef    String? // reserved: only for providers with verified continuation
  plannerVersion     Int      @default(1)
  createdAt          DateTime @default(now())
  episode            Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  script             Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([scriptId, sceneIndex])
  @@index([requestFingerprint])
}

// Managed post-production audio asset (theme, stinger, music bed, SFX,
// cleared game highlight). Every asset carries its license; game highlights
// additionally require an explicit rights affirmation before they can be
// mixed into an episode.
model AudioAsset {
  id              String  @id @default(uuid())
  name            String
  kind            String // "theme_intro" | "theme_outro" | "stinger" | "bed" | "sfx" | "highlight"
  category        String? // sfx flavor: "laugh" | "crowd" | "airhorn" | "buzzer" | "rimshot" | "whoosh" | "impact"
  tags            Json // string[]
  audioUrl        String // LEGACY compat read path; new code resolves via storageKey + provider
  storageKey      String?
  durationMs      Int?
  license         String // LEGACY free-text; superseded by licenseStatus/licenseName below
  licenseNote     String?
  rightsConfirmed Boolean @default(false) // LEGACY boolean; superseded by rightsStatus below
  isActive        Boolean @default(true)
  source          String  @default("upload") // "seed" | "upload"

  // --- Ownership scope (Prompt 6) ----------------------------------------
  // "shared_system"   admin-managed library, usable by everyone (ownerId/podcastId null)
  // "owner_private"   belongs to one User (ownerId set, podcastId null)
  // "podcast_private" belongs to one owned Podcast (ownerId + podcastId set, owners must match)
  // "legacy_global"   pre-Prompt-6 asset of ambiguous ownership: admin-only,
  //                   blocked from NEW selection until classified. The column
  //                   default is deliberately this fail-closed value so an
  //                   insert that forgets scope can never widen access.
  // NOTE: a "workspace" scope belongs to Prompt 13 (Workspaces) — do NOT add
  // it here; until then assets are user-owned, podcast-associated, or shared.
  scope                     String   @default("legacy_global")
  ownerId                   String? // User.id — required for owner_private/podcast_private
  ownerUser                 User?    @relation("OwnedAudioAssets", fields: [ownerId], references: [id], onDelete: SetNull)
  podcastId                 String? // Podcast.id — required for podcast_private only
  podcast                   Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  uploadedByUserId          String? // audit: who performed the upload (plain id, not authority)
  createdByAdminIdentity    String? // audit: admin identity for shared_system assets
  legacyScopeReviewRequired Boolean  @default(false) // true = admin must classify before new use

  // --- Immutable media content (Prompt 6) ---------------------------------
  // Once processingStatus = "ready", contentHash/storageKey/bytes are frozen
  // (a DB trigger enforces this): replacing audio creates a NEW asset that
  // supersedes this one, so historical snapshots and renders stay auditable.
  contentHash         String? // sha256 of the media bytes; null only for unrepaired legacy rows
  originalFilename    String? // display-only; NEVER used as a storage path
  mimeType            String?
  fileSizeBytes       Int?
  sampleRate          Int?
  channelCount        Int?
  bitrateKbps         Int?
  processingStatus    String       @default("ready") // "uploading" | "processing" | "ready" | "failed"
  processingError     String? // safe category only — never commands/paths/URLs
  supersededByAssetId String?
  supersededByAsset   AudioAsset?  @relation("AudioAssetSupersession", fields: [supersededByAssetId], references: [id], onDelete: SetNull)
  supersedes          AudioAsset[] @relation("AudioAssetSupersession")

  // --- Archive (never hard-delete an asset with history) ------------------
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archiveReason String?

  // --- License + rights (Prompt 6; structured, replaces the loose strings) --
  licenseStatus                  String    @default("unknown") // "original" | "licensed" | "public_domain" | "cc0" | "unknown" | "restricted" | "expired" | "revoked"
  licenseName                    String?
  licenseReference               String?
  rightsStatus                   String    @default("not_required") // "not_required" | "pending" | "confirmed" | "rejected" | "expired" | "revoked"
  rightsNotes                    String?
  allowedUse                     String? // e.g. "podcast_production"; enforced for restricted assets
  rightsConfirmedAt              DateTime?
  rightsConfirmedByUserId        String?
  rightsConfirmedByAdminIdentity String?
  rightsExpiresAt                DateTime?
  rightsDocumentStorageKey       String? // PRIVATE — never in DTOs/logs; served only via an authorized route

  // --- Cue metadata (PR 2) -----------------------------------------------
  // Admin-reviewed creative metadata (cue family, genre, mood, energy,
  // instrumentation, and per-slot suitability). Structured JSON so no new
  // musical facts are fabricated: `metadataState` gates authority —
  // "unclassified" (none), "suggested" (proposed, NOT authoritative), or
  // "verified" (admin-confirmed, usable for HARD compatibility decisions).
  // See src/lib/audio/cueMetadata.ts.
  cueMetadata   Json?
  metadataState String @default("unclassified") // "unclassified" | "suggested" | "verified"

  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  auditEvents       AudioAssetAuditEvent[]
  soundAssignments  PodcastSoundAssignment[]
  systemAssignments SystemSoundAssignment[]  @relation("SystemSoundAssignmentAsset")

  @@index([kind])
  @@index([isActive])
  @@index([scope])
  @@index([ownerId])
  @@index([podcastId])
  @@index([contentHash])
  @@index([metadataState])
}

// Immutable per-asset audit trail (Prompt 6). Append-only: nothing in the
// application updates or deletes rows here; hard-deleting an asset (allowed
// only for failed/unreferenced uploads) cascades its events away with it.
model AudioAssetAuditEvent {
  id            String     @id @default(uuid())
  assetId       String
  asset         AudioAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  event         String // created | upload_completed | metadata_extracted | metadata_failed |
  // license_updated | rights_confirmed | rights_revoked | assigned_to_podcast |
  // removed_from_podcast | archived | restored | superseded | classified | rendered
  actorType     String // "user" | "admin" | "system"
  userId        String?
  adminIdentity String?
  podcastId     String?
  metadata      Json? // SAFE fields only — never secrets/URLs/storage keys/rights docs
  createdAt     DateTime   @default(now())

  @@index([assetId, createdAt])
  @@index([event])
}

// Singleton (id = "default"): which assets voice the show's produced sound,
// plus the default production style / SFX density for new episodes.
model SoundDesignConfig {
  id                String                  @id @default("default")
  // LEGACY singleton slots (PR 2 compatibility inputs): when no
  // SystemSoundAssignment rows exist for a role, the resolver falls back to
  // these as a one-item pool so existing installs keep their sound.
  themeIntroAssetId String?
  themeOutroAssetId String?
  bedAssetId        String?
  stingerAssetIds   Json? // string[] — rotated deterministically between breaks
  defaultStyle      String                  @default("full") // "clean" | "light" | "full"
  defaultSfxDensity String                  @default("subtle") // "subtle" | "medium" | "hype"
  // Optimistic-concurrency version for the admin system-pool editor (PR 2).
  configVersion     Int                     @default(1)
  systemAssignments SystemSoundAssignment[]
  updatedAt         DateTime                @updatedAt
}

// System-default VARIANT POOLS (PR 2). The shared system profile is no longer
// one intro/outro/bed: an administrator configures weighted, ordered variant
// pools per role here, mirroring PodcastSoundAssignment but scoped to the
// singleton SoundDesignConfig. Only shared_system (or documented legacy_global
// compatibility) assets belong here — a private asset must never become a
// global system assignment. Empty pools fall back to the legacy singleton slots.
model SystemSoundAssignment {
  id                  String            @id @default(uuid())
  configId            String            @default("default")
  config              SoundDesignConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  assetId             String
  asset               AudioAsset        @relation("SystemSoundAssignmentAsset", fields: [assetId], references: [id], onDelete: Restrict)
  role                String // "intro" | "outro" | "bed" | "stinger" | "reaction"
  orderIndex          Int               @default(0)
  enabled             Boolean           @default(true)
  gainDb              Float?
  fadeInMs            Int?
  fadeOutMs           Int?
  cueFamily           String?
  weight              Float             @default(1) // bounded [0,100]
  isBrandedMotif      Boolean           @default(false)
  maxUsesPerEpisode   Int?
  minEpisodeCooldown  Int?
  allowedFormatIds    String[]          @default([])
  prohibitedFormatIds String[]          @default([])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@unique([configId, role, assetId])
  @@index([configId, role])
  @@index([configId, role, enabled])
  @@index([assetId])
}

// One row per sound asset a rendered episode consumed (stingers, beds,
// reaction SFX). The production planner reads the last N episodes' rows as
// its anti-repetition cooldown; rows are rewritten atomically when an
// episode re-renders so re-runs never double-count.
model SoundCueUsage {
  id        String   @id @default(uuid())
  episodeId String
  scriptId  String?
  assetId   String
  assetName String?
  cueType   String // "stinger" | "bed_change" | "reaction" | "theme_intro" | "theme_outro" | "highlight"
  usedAt    DateTime @default(now())

  // --- Ownership + render provenance (Prompt 6) ---------------------------
  // Cooldown reads are scoped by podcastId (default) or ownerId — NEVER
  // global — and every row snapshots the asset facts at use time so a later
  // asset edit/archive cannot rewrite render history. Legacy rows (before
  // this migration) carry selectionSource "legacy" and nulls where the truth
  // is unknown; the backfill fills owner/podcast from the Episode only.
  renderId           String?
  render             EpisodeAudioRender? @relation(fields: [renderId], references: [id], onDelete: SetNull)
  ownerId            String?
  podcastId          String?
  assetKind          String?
  assetScope         String?
  assetContentHash   String?
  lineIndex          Int?
  timelinePositionMs Int?
  orderIndex         Int?
  gainDb             Float?
  fadeInMs           Int?
  fadeOutMs          Int?
  selectionSource    String              @default("legacy") // "podcast_assignment" | "system_default" | "production_planner" | "episode_highlight" | "historical_reproduction" | "legacy"

  @@index([assetId, usedAt])
  @@index([episodeId])
  @@index([usedAt])
  @@index([podcastId, usedAt])
  @@index([ownerId, usedAt])
  @@index([renderId])
}

model JobLog {
  id        String   @id @default(uuid())
  jobType   String
  status    String
  input     Json
  output    Json
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobType])
  @@index([status])
  @@index([createdAt])
}

// IAB-style download/listen analytics (Step 9b). Privacy-first: NO raw IP or
// PII is ever stored — only a truncated salted hash of (ip + user-agent) used
// solely for dedup, a coarse app bucket derived from the user-agent, and a
// 2-letter country ONLY when the edge/proxy supplies a geo header. IAB dedup:
// the @@unique on (episodeId, clientHash, dayBucket, kind) collapses repeat
// requests from the same client for the same episode within a UTC-day window
// (range requests / re-fetches) to a single counted event. Additive
// (migration 20260708130000). ownerId is denormalized from Episode for
// owner-scoped queries; cascade cleans up on episode delete.
model PlayEvent {
  id         String   @id @default(uuid())
  episodeId  String
  ownerId    String? // Episode.ownerId at record time; null for legacy episodes
  kind       String // "download" | "play"
  source     String // "rss" | "direct" | "player"
  clientHash String // sha256(ip + ua + daily salt), truncated — never the raw IP
  country    String? // 2-letter ISO, only when a geo header is present; else null
  appBucket  String? // coarse client bucket from UA (Apple Podcasts, Spotify, Web, …)
  dayBucket  String // UTC "YYYY-MM-DD" — the IAB dedup window
  at         DateTime @default(now())
  episode    Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, clientHash, dayBucket, kind])
  @@index([ownerId, at])
  @@index([episodeId, kind])
}

// Privacy-safe playback milestones and blinded preference signals. No raw IP,
// account id, cookie value or free-form listener text is stored.
model ListenerSignal {
  id                String   @id @default(uuid())
  episodeId          String
  ownerId            String?
  sessionHash        String
  milestone          String // start | 15s | 60s | 180s | complete | next_episode | cold_open_vote | sounds_human | host_distinguishable
  positionSeconds    Int?
  durationSeconds    Int?
  value              Float?
  coldOpenVariant    String?
  metadata           Json?
  at                 DateTime @default(now())
  episode             Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, sessionHash, milestone])
  @@index([episodeId, milestone])
  @@index([ownerId, at])
  @@index([coldOpenVariant, milestone])
}

// Auto social clip — a short vertical (9:16) captioned promo cut of an episode's
// spiciest exchange. Selection reuses the real transcript tone/energy; the clip
// audio is rendered from the real per-line AudioSegment audio via the same
// ffmpeg path the full stitch uses. Additive (migration 20260708120000).
model SocialClip {
  id             String   @id @default(uuid())
  episodeId      String
  scriptId       String
  ownerId        String? // creator (Episode.ownerId); null for legacy episodes
  startLineIndex Int
  endLineIndex   Int
  title          String?
  status         String   @default("pending") // pending | rendering | ready | failed
  kind           String? // "video" (9:16 mp4) | "audio+captions" (mp3 + vtt fallback)
  audioUrl       String? // always produced (real episode audio)
  videoUrl       String? // 9:16 burned-caption mp4 when the ffmpeg build allows it
  captionsUrl    String? // WebVTT caption track (host-colour cues)
  durationMs     Int?
  autoSelected   Boolean  @default(false)
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  episode        Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([ownerId])
}

// Persistent, per-show continuity state — what turns a hundred disconnected
// episodes into a season. One row per Podcast.
//
// There is deliberately NO season concept here. "Twice a season" and
// "episode 16" are different kinds of thing and only one needs a boundary;
// modelling seasons would add a reset job whose only purpose is to be got
// wrong. Episode.seasonNumber already exists for RSS packaging, which is a
// display concern and stays separate from these mechanics.
//
// NOTHING HERE IS MANDATORY PER EPISODE. The previous version of this model
// stored a recurring-comedy scoreboard (attendance figures, pronoun counts, a
// teammate rotation) and the prompt required every one of them in every
// episode. Those columns were archived to "ShowContinuityLegacyDutch" and
// dropped — see migration 20260727000000_replace_dutch_continuity_with_red_eye.
//
// Every field below is exactly one of four kinds. New fields must declare
// which, because the kind determines the update rule:
//
//   1. COUNTER    monotonic, never resets, no boundary.
//   2. LADDER     one-shot rungs, monotonic, TERMINATES. Each rung fires once
//                 and is consumed; a ladder never wraps. On reaching its
//                 authored end the generator stops advancing it and the show
//                 runs standalone episodes — it must never invent a new rung.
//   3. RATE LIMIT rolling window over episode indices. Stored as the list of
//                 indices where it fired, NOT as a count, so scarcity works
//                 without a boundary and there is no reset logic.
//   4. LOG        append-only evidence, capped. Read through the validators in
//                 showContinuity.ts, never trusted raw.
model ShowContinuity {
  id        String  @id @default(cuid())
  podcastId String  @unique
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  // COUNTER — the index every rolling window below is measured against.
  episodeCount Int @default(0)

  // --- The Red Eye File ---------------------------------------------------
  // Cal Mercer's one unresolved career decision, revealed in authored layers.
  // FICTIONAL AND COMPOSITE: never attached to a real person, team, or event.
  redEyeStage       Int      @default(0) // LADDER, terminates at RED_EYE_LADDER_END
  redEyeDisclosures String[] @default([]) // what has already been confessed; never repeat one
  redEyeFirings     Int[]    @default([]) // RATE LIMIT — episode indices, newest last

  // --- The Language Ledger ------------------------------------------------
  // LOG of the institutional phrases Cal reached for, and whether he later
  // rejected or revised one. Evidence of how he hides, not a gag counter.
  // Shape: LedgerEntry[] in src/lib/services/showContinuity.ts.
  languageLedger        Json  @default("[]")
  languageRecallFirings Int[] @default([]) // RATE LIMIT

  // --- Position memory ----------------------------------------------------
  // LOG of what each host actually argued, so a callback can be checked for
  // relevance rather than asserted. Shape: PositionEntry[].
  positionMemory          Json  @default("[]")
  positionCallbackFirings Int[] @default([]) // RATE LIMIT

  // --- Relationship movement ----------------------------------------------
  // Compact state that STEERS writing. Never rendered as a number in a prompt
  // and never spoken: a visible score turns the show into a game mechanic.
  trustLevel               Int     @default(0) // -5..5, clamped on write
  calDisclosureCount       Int     @default(0) // COUNTER
  calRationalizationCount  Int     @default(0) // COUNTER
  zabalaOverreachCount     Int     @default(0) // COUNTER
  positionChangeCount      Int     @default(0) // COUNTER — either host moved the other
  openThread               String? // the interpersonal thread still hanging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Rollback archive for the retired Dutch Mulkey continuity columns.
//
// Retained for ONE release so a rollback can restore the old state rather than
// losing it. NOTHING IN THE RUNTIME READS THIS TABLE — that is the point. It
// exists so the dropped columns are recoverable, and it is safe to drop once
// the replacement has shipped and been accepted.
model ShowContinuityLegacyDutch {
  podcastId             String   @id
  episodeCount          Int      @default(0)
  phantomFansTotal      Int      @default(0)
  lastAttendanceClaim   Int?
  lastAttendanceReal    Int?
  weCount               Int      @default(0)
  weCountThisEpisode    Int      @default(0)
  currentDodge          String?
  hoytStage             Int      @default(0)
  hoytFactsEstablished  String[] @default([])
  arcBeat               Int      @default(0)
  badgeStage            Int      @default(0)
  wolverinesInvoked     String[] @default([])
  lastWolverineUsed     String?
  nuclearOptionFirings  Int[]    @default([])
  coldOpenFullRuns      Int[]    @default([])
  uncorrectedLedgerRuns Int[]    @default([])
  wagerTerms            String?
  wagerLeader           String?
  wagerPot              Int      @default(0)
  archivedAt            DateTime @default(now())
}

// ===========================================================================
// BLIND LONG-FORM VOICE AUDITION
//
// Appended additively. No existing model or column is touched, and none of
// these tables carry a foreign key into an existing table: hostId, ownerId,
// actorId and voterId are plain ids so this block can be added (and dropped)
// without touching AiHost or User. Service layer: src/lib/services/voiceAudition.ts.
// ===========================================================================

/// One blind casting session. Every candidate performs the same versioned
/// eight-scene pack so the recordings are actually comparable.
model VoiceAudition {
  id      String  @id @default(uuid())
  ownerId String? // User.id of the producer running it (no FK by design)
  hostId  String? // AiHost.id this is casting for (no FK by design)
  title   String
  /// draft | voting | decided | promoted | abandoned
  status  String  @default("draft")

  /// Votes are only comparable within one pack version. Recorded, never inferred.
  packVersion   String
  packSceneIds  String[] @default([])
  policyVersion Int      @default(1)

  /// Seeds the shuffle that assigns "Voice A/B/C", so ballot order does not
  /// encode which candidate was entered first (usually the incumbent).
  blindSeed String

  /// Choosing a winner is an opinion. It changes no production voice.
  winnerCandidateId  String?
  winnerSelectedAt   DateTime?
  winnerSelectedById String?

  /// Unblinding is legal only after a winner exists, and is recorded.
  unblindedAt   DateTime?
  unblindedById String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates VoiceAuditionCandidate[]
  votes      VoiceAuditionVote[]
  promotions VoicePromotion[]

  @@index([ownerId, createdAt])
  @@index([hostId])
}

/// One voice under audition. `provider`, `voiceId`, `model` and
/// `generationSettings` are the IDENTITY columns: the ballot query
/// (BALLOT_SELECT in voiceAudition.ts) never selects them.
model VoiceAuditionCandidate {
  id         String        @id @default(uuid())
  auditionId String
  audition   VoiceAudition @relation(fields: [auditionId], references: [id], onDelete: Cascade)

  /// The opaque handle the voting surface uses. Random, not derived from the
  /// voice, so it cannot be reversed into an identity.
  ballotId      String @unique
  blindPosition Int

  /// Producer-only note ("incumbent", "fish redesign"). Never on a ballot.
  privateLabel String?

  // --- identity (never selected by the blind path) ---
  provider           String
  voiceId            String
  model              String?
  generationSettings Json?

  // --- rendered artifact (keyed by ballotId, so the URL leaks nothing) ---
  audioAssetKey    String?
  audioAssetUrl    String?
  audioContentType String?
  audioBytes       Int?
  durationMs       Int?
  renderedAt       DateTime?
  renderError      String?

  /// AuditionMetrics from spokenPerformanceQa — advisory, never auto-deciding.
  metrics Json?

  createdAt DateTime @default(now())

  votes VoiceAuditionVote[]

  @@unique([auditionId, blindPosition])
  @@index([auditionId])
}

/// One listener's scores for one blind candidate. Every dimension is
/// "higher is better", including listenerFatigue, which is scored as stamina.
model VoiceAuditionVote {
  id          String                 @id @default(uuid())
  auditionId  String
  audition    VoiceAudition          @relation(fields: [auditionId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   VoiceAuditionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  voterId    String
  voterLabel String?

  characterFit        Int
  identityConsistency Int
  listenerFatigue     Int
  spontaneity         Int
  intelligibility     Int
  emotionalRange      Int
  interruptionQuality Int
  pairChemistry       Int
  overall             Int

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, voterId])
  @@index([auditionId])
}

/// The voice-change audit trail, and the rollback mechanism.
///
/// kind="promotion" rows record a deliberate voice change (who, when, from
/// which audition, and the previous voice). kind="rollback" rows are the
/// reversals, pointing back via revertsPromotionId. Nothing in the pipeline
/// writes here automatically — a promotion is always a human act.
model VoicePromotion {
  id     String @id @default(uuid())
  hostId String
  /// promotion | rollback
  kind   String @default("promotion")

  auditionId  String?
  audition    VoiceAudition? @relation(fields: [auditionId], references: [id], onDelete: SetNull)
  candidateId String?

  /// The voice being replaced — this is what a rollback restores.
  fromProvider String?
  fromVoiceId  String?
  fromModel    String?

  toProvider String
  toVoiceId  String
  toModel    String?

  /// Attribution. A voice change with no name attached is not acceptable.
  actorId    String
  actorLabel String?
  reason     String?

  policyVersion Int @default(1)

  /// active | rolled_back | reversal
  status             String  @default("active")
  revertsPromotionId String?

  rolledBackAt     DateTime?
  rolledBackById   String?
  rolledBackReason String?

  createdAt DateTime @default(now())

  @@index([hostId, createdAt])
  @@index([auditionId])
  @@index([revertsPromotionId])
}

// ===========================================================================
// CLOSED LISTENER-LEARNING LOOP
// (migration 20260802010000_add_listener_learning — PURELY ADDITIVE)
//
// The loop: collect -> aggregate -> evaluate -> promote/reject -> rollback.
//
// Two storage layers, deliberately separate:
//   • ListenerLearningEvent     RAW, attributable, append-only. THE RECORD.
//   • ListenerLearningAggregate DERIVED and fully recomputable from the raw
//                               events. Safe to truncate and rebuild.
// Nothing reads an aggregate as evidence of anything the raw events cannot
// reproduce; see recomputeAggregates() in src/lib/services/listenerLearning.ts.
//
// PRIVACY: listenerHash is sha256(rawId | day | salt) truncated — the raw
// identifier is never persisted, no IP, no user-agent, no free text. `country`
// is a 2-letter ISO code from an edge geo header only. `consented` records the
// explicit listener opt-in that gated collection. `expiresAt` is the retention
// horizon; purgeExpiredLearningEvents() is the documented purge path.
//
// No relations to existing tables on purpose (episodeId / podcastId are plain
// ids), so this whole block can be added or dropped without touching Episode,
// Podcast or any existing constraint.
// ===========================================================================

model ListenerLearningEvent {
  id String @id @default(uuid())

  /// One of the 14 keys in LEARNING_SIGNALS (src/lib/services/listenerLearning.ts).
  signalKey String
  /// listener | panel | production — where the measurement came from.
  source    String

  // --- Attribution dimensions (all nullable: a signal is recorded with the
  // dimensions that are actually known, never with invented ones) -----------
  episodeId               String?
  podcastId               String?
  formatId                String?
  /// Cold-open / opening archetype in force for the measured episode.
  openingVariant          String?
  /// Stable, order-independent key for the host pair (e.g. "cal|zabala").
  hostPairKey             String?
  voicePolicyVersion      Int?
  productionPolicyVersion Int?

  // --- Privacy-bearing fields ----------------------------------------------
  /// Salted hash. NEVER a raw session id, account id, cookie or IP.
  listenerHash String?
  /// Coarse panel/experiment cohort label. Never a person.
  cohort       String?
  /// Explicit opt-in captured at collection time.
  consented    Boolean @default(false)
  /// 2-letter ISO country from a geo header, or null. Nothing finer.
  country      String?

  /// The measured number, already clamped into the signal's declared range.
  value      Float
  /// Units of `value` — "ratio" | "usd_per_minute" | "score_0_1".
  unit       String
  occurredAt DateTime @default(now())
  /// Retention horizon. Rows past this are purged; see the purge path.
  expiresAt  DateTime
  /// Non-identifying context only (sanitized on write).
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([podcastId, signalKey, occurredAt])
  @@index([episodeId, signalKey])
  @@index([expiresAt])
  @@index([listenerHash])
}

/// DERIVED rollups. Every row is reproducible from ListenerLearningEvent by
/// recomputeAggregates(); nothing is written here that raw events cannot
/// regenerate. scopeKind ∈ episode | show | format | opening_variant |
/// host_pair | voice_policy | production_policy.
model ListenerLearningAggregate {
  id        String @id @default(uuid())
  podcastId String

  scopeKind String
  scopeKey  String
  signalKey String

  sampleSize Int
  mean       Float
  sum        Float
  minValue   Float
  maxValue   Float
  stdDev     Float
  /// Half-width of the 95% interval around `mean`.
  marginOfError Float
  /// low | moderate | high — sample-size + spread driven, never asserted.
  confidence    String

  windowStart DateTime
  windowEnd   DateTime
  computedAt  DateTime @default(now())

  @@unique([podcastId, scopeKind, scopeKey, signalKey])
  @@index([podcastId, signalKey])
}

/// A blind head-to-head cold-open test. The variant ids live ONLY here; the
/// payload served to the listener carries slot labels ("A"/"B") and slot-scoped
/// media URLs, never the variant identity. See buildColdOpenTrial().
model ColdOpenPairwiseTrial {
  id         String @id @default(uuid())
  /// Opaque token the listener's client echoes back. Not derived from variants.
  trialToken String @unique

  episodeId String?
  podcastId String?

  /// Variant served in slot A / slot B. SERVER-SIDE ONLY.
  slotAVariantId String
  slotBVariantId String

  listenerHash String?
  consented    Boolean @default(false)
  country      String?

  /// "A" | "B" once decided.
  winnerSlot      String?
  winnerVariantId String?
  decidedAt       DateTime?

  servedAt  DateTime @default(now())
  expiresAt DateTime

  @@index([podcastId, servedAt])
  @@index([episodeId])
}

/// Versioned, PER-SHOW production policy. Scoped by podcastId so a preference
/// learned on one show can never homogenize another. `preferences` holds ONLY
/// the bounded adjustable fields; `immutableRules` is the frozen snapshot of
/// evidence/safety/character rules that learning may never touch.
model ProductionPolicyVersion {
  id        String @id @default(uuid())
  podcastId String
  version   Int

  /// active | superseded | rolled_back
  status String @default("active")

  preferences    Json
  immutableRules Json

  /// Human-readable "why". Never empty for a promoted version.
  rationale String

  /// Explainability payload: causing episode ids, listener cohorts, the
  /// signals + sample sizes + confidence that justified the change.
  evidence Json

  promotedFromVersion Int?
  promotedBy          String?
  promotedAt          DateTime  @default(now())
  rolledBackAt        DateTime?
  rolledBackBy        String?
  rolledBackReason    String?

  createdAt DateTime @default(now())

  @@unique([podcastId, version])
  @@index([podcastId, status])
}

/// Every promotion ATTEMPT, including the refusals. An automated change that
/// did not happen must leave a reason behind, or the loop is not auditable.
model ProductionPolicyDecision {
  id        String @id @default(uuid())
  podcastId String

  /// promoted | rejected | rolled_back
  outcome String
  /// Machine code: insufficient_sample | low_confidence | immutable_field |
  /// out_of_bounds | unknown_field | no_prior_version | promoted | rolled_back
  code    String
  reason  String

  resultingVersion Int?
  detail           Json?
  actor            String?
  decidedAt        DateTime @default(now())

  @@index([podcastId, decidedAt])
}

// ---------------------------------------------------------------------------
// Editorial-gate rollout: durable legacy release
//
// The first version of the rollout policy was a PURE FUNCTION. It said a
// pre-cutover script was "allowed once", but nothing was persisted, so the same
// script was re-grandfathered at every queue boundary and again after every
// worker restart. The claim was false.
//
// A release is now a ROW. One per script, enforced by a unique constraint, so
// "one decision per script" is a database invariant rather than a sentence in a
// comment. It records who released it (a system actor for the automatic
// compatibility path), what it was compared against, and exactly which
// downstream stages it permits.
//
// This exists ONLY for attributable in-flight compatibility. The preferred
// remedy is `npm run gate:reevaluate`, which replaces the release with a real
// verdict.
// ---------------------------------------------------------------------------
model ScriptLegacyRelease {
  id String @id @default(uuid())

  /// One release per script. This unique constraint is what makes the
  /// "one decision per script" guarantee real.
  scriptId String @unique

  /// What the policy compared, kept so an auditor never has to re-derive it.
  scriptCreatedAt DateTime
  cutoverAt       DateTime
  reason          String

  /// Who released it. The automatic compatibility path records a SYSTEM actor
  /// so it is never mistaken for a person's decision.
  actorKind String  @default("system") // "system" | "human"
  actorId   String?

  /// Exactly which downstream stages this release permits. A release is not a
  /// blanket pass for anything the pipeline might do later.
  permittedStages String[]

  createdAt DateTime @default(now())

  /// Revoking is how an operator takes a release back without deleting the
  /// audit trail.
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?

  @@index([createdAt])
  @@index([revokedAt])
}
